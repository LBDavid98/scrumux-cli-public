# Harness gateway env — copy to .env (gitignored) and fill it in.
#
# The `block-direct-llm` wall requires model traffic to go through whatever
# gateway THIS repo has declared, so that keys, model policy and spend have one
# home rather than one per caller. Point these at yours; the harness does not
# care which gateway it is, only that the repo declares one.
#
# Never commit .env.
GATEWAY_URL=
GATEWAY_API_KEY=
GATEWAY_USER_ID=
