.DS_Store
.deploy-claude/settings.local.json
*.tmp.*
# Session handoff scripts (<repo>-<session8>.sh) live at the repo ROOT.
# Root-anchored on purpose: unanchored, git applies this at any depth
# and it swallowed tests/harness-tests.sh — a registered health check
# with 127 assertions — for as long as that suite has existed (I-0098).
/harness-*.sh
.env
.venv/
__pycache__/
*.lock
governance/.cache/
# Pre-write copies of the journals, kept by _write_json_body. Local recovery
# only -- a clone still starts with its own empty journals (2026-08-23).
governance/.backups/

# --- this repo's own working record, not the product (2026-08-23) ---
# Every one of these is regenerated by scrumux on first write, verified
# before they were untracked. They are the diary of BUILDING the harness;
# a clone should start with its own, empty.
AI_LOG.MD
BACKLOG.MD
DECISIONS.MD
governance/*.json
governance/acceptance/
governance/attestations.jsonl
governance/validator-memory.md
# Operational intel for a private gateway. Never belonged in a product.
governance/llm-gateway-intel.md

# The walls' runtime event stream (walls-lib.sh appends here). Same class as
# the working-record block above: local diary, a clone starts with its own (2026-08-31).
.scrumux/

# --- the TypeScript port (Phase 1b onward) ---
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# --- generated test corpora (Phase 1c/1d) ---
# Both are REGENERABLE and neither is the deliverable. The sandbox fixtures
# are a projection of tools/sandbox/scenario.mjs (`npm run sandbox`); the
# corpus tier is a scrub of the local journals (`npm run corpus`), and those
# journals are gitignored above because they are the diary of building the
# harness -- a fixture directory is not a loophole for that.
#
# What IS committed is test/baseline/sandbox-bash.json, the canonicalised
# bash transcript. That is the artifact every later phase diffs against.
test/fixtures/sandbox/
test/fixtures/corpus/

# npm pack output — a build artifact, never a commit.
*.tgz
